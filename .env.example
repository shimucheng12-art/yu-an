# 余安 Beta 云端环境变量
# PostgreSQL 数据库（Supabase / Neon / Vercel Postgres 均可）
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# JWT 签名密钥：请使用至少 32 字节随机字符串
JWT_SECRET=change-me-to-a-long-random-string

# Socket.io 内部广播密钥
INTERNAL_SECRET=change-me-internal-secret

# Android / 前端使用的云端 API 地址（部署后填写）
NEXT_PUBLIC_API_BASE_URL=https://your-yuan-api.example.com
